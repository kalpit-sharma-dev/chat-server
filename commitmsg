#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat $COMMIT_MSG_FILE)

# Jira pattern (customize if needed)
JIRA_REGEX="^[A-Z]+-[0-9]+"

echo "🔍 Validating commit message..."

if ! echo "$COMMIT_MSG" | grep -qE "$JIRA_REGEX"; then
  echo "❌ Invalid commit message!"
  echo ""
  echo "👉 Format must be:"
  echo "   ABC-123: Your commit message"
  echo ""
  echo "Examples:"
  echo "   PAY-101: Add retry logic for payment API"
  echo "   AUTH-55: Fix token validation bug"
  echo ""
  exit 1
fi

echo "✅ Commit message is valid"
