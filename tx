package main

import (
	"encoding/json"
	"fmt"
	"os"

	"github.com/xuri/excelize/v2"
)

// Config represents the JSON structure
 type Config struct {
	PK         string `json:"PK"`
	ParamKey   string `json:"param_key"`
	SubParamKey string `json:"sub_param_key"`
	ConfigGroup string `json:"config_group"`
	ParamValue  string `json:"param_value"`
	PriorityOrder int `json:"priority_order,omitempty"`
	ParamDesc   string `json:"param_desc,omitempty"`
	Priority    string `json:"priority,omitempty"`
}

func main() {
	// Read JSON file
	fileData, err := os.ReadFile("input.json")
	if err != nil {
		fmt.Println("Error reading file:", err)
		return
	}

	var configs []Config
	if err := json.Unmarshal(fileData, &configs); err != nil {
		fmt.Println("Error unmarshalling JSON:", err)
		return
	}

	f := excelize.NewFile()
	sheet := "Sheet1"
	f.SetSheetName("Sheet1", sheet)

	// Header row
	headers := []string{"PK", "param_key", "sub_param_key", "config_group", "param_value", "priority_order", "param_desc", "priority"}
	for i, h := range headers {
		cell := fmt.Sprintf("%c1", 'A'+i)
		f.SetCellValue(sheet, cell, h)
	}

	// Data rows
	for i, config := range configs {
		row := i + 2 // Start from row 2
		f.SetCellValue(sheet, fmt.Sprintf("A%d", row), config.PK)
		f.SetCellValue(sheet, fmt.Sprintf("B%d", row), config.ParamKey)
		f.SetCellValue(sheet, fmt.Sprintf("C%d", row), config.SubParamKey)
		f.SetCellValue(sheet, fmt.Sprintf("D%d", row), config.ConfigGroup)
		f.SetCellValue(sheet, fmt.Sprintf("E%d", row), config.ParamValue)
		f.SetCellValue(sheet, fmt.Sprintf("F%d", row), config.PriorityOrder)
		f.SetCellValue(sheet, fmt.Sprintf("G%d", row), config.ParamDesc)
		f.SetCellValue(sheet, fmt.Sprintf("H%d", row), config.Priority)
	}

	// Save the file
	if err := f.SaveAs("output.xlsx"); err != nil {
		fmt.Println("Error saving file:", err)
	} else {
		fmt.Println("Excel file generated: output.xlsx")
	}
}

