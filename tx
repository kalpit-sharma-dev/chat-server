import torch
from transformers import BertForSequenceClassification, RobertaForSequenceClassification, DistilBertForSequenceClassification
from transformers import BertTokenizer, RobertaTokenizer, DistilBertTokenizer
from torch.nn.functional import softmax

# Load trained models
models = {
    "bert": BertForSequenceClassification.from_pretrained("./bert_classifier"),
    "roberta": RobertaForSequenceClassification.from_pretrained("./roberta_classifier"),
    "distilbert": DistilBertForSequenceClassification.from_pretrained("./distilbert_classifier"),
}

# Load tokenizers
tokenizers = {
    "bert": BertTokenizer.from_pretrained("./bert_classifier"),
    "roberta": RobertaTokenizer.from_pretrained("./roberta_classifier"),
    "distilbert": DistilBertTokenizer.from_pretrained("./distilbert_classifier"),
}

# Function to perform ensemble classification
def classify_error_ensemble(message):
    predictions = []
    
    for model_name, model in models.items():
        tokenizer = tokenizers[model_name]
        inputs = tokenizer(message, return_tensors="pt", padding=True, truncation=True)
        
        with torch.no_grad():
            logits = model(**inputs).logits
            probabilities = softmax(logits, dim=1)
            pred_label = torch.argmax(logits).item()
        
        predictions.append(probabilities.numpy()[0])  # Store probabilities
    
    # Average probabilities across models
    avg_probs = torch.tensor(predictions).mean(dim=0)
    final_pred = torch.argmax(avg_probs).item()
    
    category = "Technical" if final_pred == 0 else "Functional"
    return {"category": category, "probabilities": avg_probs.tolist()}

# Test classification
message = "Transaction failed due to a system error."
result = classify_error_ensemble(message)
print(result)







