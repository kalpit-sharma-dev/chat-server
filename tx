from fastapi import FastAPI
from pydantic import BaseModel

app = FastAPI()

class ErrorMessage(BaseModel):
    message: str

@app.post("/classify")
async def classify_error_message(error: ErrorMessage):
    result = classify_error_ensemble(error.message)
    return result


